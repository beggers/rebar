+            Py_DECREF(frame);
+            PyErr_SetString(PyExc_RecursionError, "maximum recursion depth exceeded");
+            return NULL;
+        }
+        live_frames++;
+        PyFrameObject *back = PyFrame_GetBack(frame);
+        Py_DECREF(frame);
+        frame = back;
+    }
